{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "build monopoly",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "main.cpp",
                "-o",
                "monopoly.exe",
                "-lmingw32",
                "-lSDL2"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}